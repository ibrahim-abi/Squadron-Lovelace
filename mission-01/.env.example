# Copy this file to .env (git-ignored) and fill in the key for the provider you use.
# Only one provider is needed. The engine reads .env only with --llm api.
GEMINI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional overrides
# AURA_GEMINI_MODEL=gemini-3.5-flash-lite
# AURA_GEMINI_RPM=8        # requests per minute; 0 = no spacing (paid tier)
# AURA_GROQ_MODEL=openai/gpt-oss-120b
# AURA_GROQ_RPM=6          # Groq free tier: 8K tokens/min
